# The frame sync FSM (buildplan §8.3): fec_fs_fsm's own SVA (verify queue, judgment never skipped, miss counter,
# descriptor outputs) and the harness's frame spacing and flywheel limit, at FRAME = 16 with 8-bit positions.
#   prove  unbounded (k-induction)
#   cover  every behaviour the properties guard is reachable: lock, a confirm's two frames, a slip, loss of lock, a
#          flywheel frame, a dropped peak, an early frame
# Read with yosys-slang, SYNTHESIS undefined so the RTL's SVA is in.
[tasks]
prove
cover

[options]
prove: mode prove
prove: depth 20
cover: mode cover
cover: depth 60

[engines]
smtbmc bitwuzla

[script]
plugin -i slang
read_slang -U SYNTHESIS -D FORMAL --top fec_fs_fsm_fv fec_fs_fsm.sv fec_fs_fsm_fv.sv
prep

[files]
../../rtl/fec/fec_fs_fsm.sv
fec_fs_fsm_fv.sv
